# Server
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://indietech:changeme@localhost:5432/indietech?sslmode=disable

# Auth
JWT_SECRET=change_this_to_a_long_random_string
TICKET_LOOKUP_SALT=change_this_too

# M-Pesa Daraja — Till (Buy Goods) integration, sandbox values shown
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE: the shortcode used for OAuth + STK password generation.
# For sandbox testing, Safaricom's test till 174379 works with test passkey.
# In production this may differ from your customer-facing till — confirm
# with Safaricom which shortcode your STK push credentials are bound to.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.co.ke/api/v1/mpesa/callback
# MPESA_TILL_NUMBER: your actual customer-facing Till number (PartyB in the
# STK push request) — this is what appears on the customer's payment prompt.
MPESA_TILL_NUMBER=

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change_this_verify_token
WHATSAPP_API_VERSION=v20.0
